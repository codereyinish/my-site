---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { TECH_ICONS } from '../lib/techIcons';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Resume — Manish Bista" description="Manish Bista's resume." />
	</head>
	<body>
		<Header />
		<main class="page-main">
			<div class="container">
				<div class="page-header animate-fadeInDown">
					<p class="eyebrow mono">CV</p>
					<h1>Résumé</h1>
					<p class="page-sub">AI engineer building production speech and ML systems — real-time transcription, serverless GPU inference, and the cloud infrastructure they run on.</p>
					<div style="margin-top:24px;display:flex;gap:12px;flex-wrap:wrap;">
						<a href="/manish_bista_resume.pdf" target="_blank" rel="noopener" class="btn btn-primary" style="display:inline-flex">
							View Resume
							<svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
						</a>
						<a href="/manish_bista_resume.pdf" download class="btn btn-outline" style="display:inline-flex">
							Download Resume
							<svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 16l-4-4m4 4l4-4m-4 4V4M4 20h16"/></svg>
						</a>
					</div>
				</div>

				<div class="section-divider"></div>

				<div class="resume-grid animate-fadeInUp delay-1">
					<div class="resume-main">

						<section class="resume-section">
							<h2 class="section-title mono">Experience</h2>
							<div class="resume-items">
								<div class="resume-item">
									<div class="item-header">
										<div>
											<h3 class="item-role">Founder</h3>
											<p class="item-org">ClassRec · classrec.com</p>
										</div>
										<span class="item-date mono">Jan 2026 – Present</span>
									</div>
									<ul class="item-bullets">
										<li>Built and deployed a full-stack web app enabling students to upload or live-record lectures and receive AI-generated transcripts</li>
										<li>Eliminated ~30% of hallucinated transcript segments by integrating Silero VAD via ONNX Runtime for silence detection before passing audio to Whisper</li>
										<li>Deployed faster-whisper large-v3 on Modal serverless GPU (T4), cutting per-lecture inference cost ~65% vs OpenAI Whisper API while improving accuracy on accented speech</li>
									</ul>
								</div>
								<div class="resume-item">
									<div class="item-header">
										<div>
											<h3 class="item-role">AI Engineer</h3>
											<p class="item-org">TalentSathi (Freelance) · Kathmandu, Nepal · Remote</p>
										</div>
										<span class="item-date mono">Feb 2024 – Present</span>
									</div>
									<ul class="item-bullets">
										<li>Built a classifier that flags bot and fraudulent applications before they reach human reviewers, filtering spam out of the recruiter queue</li>
										<li>Automated first-pass candidate screening, cutting review time from 1 hour to 10 minutes per 100 applications</li>
									</ul>
								</div>
								<div class="resume-item">
									<div class="item-header">
										<div>
											<h3 class="item-role">Technical Solutions Engineer</h3>
											<p class="item-org">NestNepal</p>
										</div>
										<span class="item-date mono">2026 – Present</span>
									</div>
									<ul class="item-bullets">
										<li>Scoped and sized cloud infrastructure for customer workloads, translating traffic, storage and uptime requirements into concrete server, storage and network configurations</li>
									</ul>
								</div>
							</div>
						</section>

						<section class="resume-section">
							<h2 class="section-title mono">Education</h2>
							<div class="resume-items">
								<div class="resume-item">
									<div class="item-header">
										<div>
											<h3 class="item-role">B.S. Mathematics / Computer Science</h3>
											<p class="item-org">St. Joseph's University, New York — Brooklyn · Minor in Data Science · GPA 3.6 / 4.0</p>
										</div>
										<span class="item-date mono">May 2026</span>
									</div>
								</div>
							</div>
						</section>

						<section class="resume-section">
							<h2 class="section-title mono">Projects</h2>
							<div class="resume-items">
								<div class="resume-item">
									<div class="item-header">
										<div>
											<h3 class="item-role">ColdVPN &amp; ColdSpot</h3>
											<p class="item-org">Your own one-click VPN</p>
										</div>
										<span class="item-date mono">2026</span>
									</div>
									<ul class="item-bullets">
										<li>Zero-config VPN: one download sets up a private server and starts encrypting all device traffic automatically</li>
										<li>Captures traffic at the network layer, so even apps that bypass proxy settings are tunneled; ColdSpot relays it through a paired iPhone to a self-hosted exit server</li>
									</ul>
								</div>
								<div class="resume-item">
									<div class="item-header">
										<div>
											<h3 class="item-role">CloudBot</h3>
											<p class="item-org">AI food ordering chatbot</p>
										</div>
									</div>
									<ul class="item-bullets">
										<li>AI chatbot that takes food orders in natural language and processes them in real time</li>
										<li>NLP intent recognition with Dialogflow ES; FastAPI webhook persists orders to Cloud SQL</li>
									</ul>
								</div>
								<div class="resume-item">
									<div class="item-header">
										<div>
											<h3 class="item-role">MBGPT</h3>
											<p class="item-org">Fine-tuned LLM for YouTube comment replies</p>
										</div>
										<span class="item-date mono">2024</span>
									</div>
									<ul class="item-bullets">
										<li>Fine-tuned LLM that generates context-aware replies to YouTube comments</li>
										<li>Quantized Mistral-7B with QLoRA, cutting model size ~75% and enabling CPU inference on a 16GB MacBook</li>
										<li>Parameter-efficient fine-tuning (QLoRA/PEFT) on a custom YouTube comment dataset</li>
									</ul>
								</div>
							</div>
						</section>

					</div>

					<aside class="resume-sidebar">
						<div class="sidebar-card">
							<h3 class="card-title mono">Skills</h3>
							<div class="skills-group">
								<p class="skill-label">AI / ML</p>
								<div class="skill-tags">
									<span><Fragment set:html={TECH_ICONS['PyTorch'] ?? ''}/>PyTorch</span><span><Fragment set:html={TECH_ICONS['HuggingFace'] ?? ''}/>HuggingFace</span><span><Fragment set:html={TECH_ICONS['Transformers'] ?? ''}/>Transformers</span><span><Fragment set:html={TECH_ICONS['LangChain'] ?? ''}/>LangChain</span><span><Fragment set:html={TECH_ICONS['faster-whisper'] ?? ''}/>faster-whisper</span><span><Fragment set:html={TECH_ICONS['Streamlit'] ?? ''}/>Streamlit</span>
								</div>
							</div>
							<div class="skills-group">
								<p class="skill-label">Backend &amp; Cloud</p>
								<div class="skill-tags">
									<span><Fragment set:html={TECH_ICONS['FastAPI'] ?? ''}/>FastAPI</span><span><Fragment set:html={TECH_ICONS['Node.js'] ?? ''}/>Node.js</span><span><Fragment set:html={TECH_ICONS['Docker'] ?? ''}/>Docker</span><span><Fragment set:html={TECH_ICONS['Modal'] ?? ''}/>Modal</span><span><Fragment set:html={TECH_ICONS['GCP'] ?? ''}/>GCP</span><span><Fragment set:html={TECH_ICONS['DigitalOcean'] ?? ''}/>DigitalOcean</span>
								</div>
							</div>
							<div class="skills-group">
								<p class="skill-label">Languages</p>
								<div class="skill-tags">
									<span><Fragment set:html={TECH_ICONS['Python'] ?? ''}/>Python</span><span><Fragment set:html={TECH_ICONS['JavaScript'] ?? ''}/>JavaScript</span><span><Fragment set:html={TECH_ICONS['Java'] ?? ''}/>Java</span><span><Fragment set:html={TECH_ICONS['Go'] ?? ''}/>Go</span><span><Fragment set:html={TECH_ICONS['C'] ?? ''}/>C</span><span><Fragment set:html={TECH_ICONS['R'] ?? ''}/>R</span><span><Fragment set:html={TECH_ICONS['SQL'] ?? ''}/>SQL</span>
								</div>
							</div>
							<div class="skills-group">
								<p class="skill-label">Networking</p>
								<div class="skill-tags">
									<span><Fragment set:html={TECH_ICONS['WireGuard'] ?? ''}/>WireGuard</span><span><Fragment set:html={TECH_ICONS['TCP/IP'] ?? ''}/>TCP/IP</span><span><Fragment set:html={TECH_ICONS['SOCKS5'] ?? ''}/>SOCKS5</span><span><Fragment set:html={TECH_ICONS['TLS'] ?? ''}/>TLS</span><span><Fragment set:html={TECH_ICONS['Terraform'] ?? ''}/>Terraform</span>
								</div>
							</div>
							<div class="skills-group">
								<p class="skill-label">Data Science</p>
								<div class="skill-tags">
									<span><Fragment set:html={TECH_ICONS['Pandas'] ?? ''}/>Pandas</span><span><Fragment set:html={TECH_ICONS['NumPy'] ?? ''}/>NumPy</span><span><Fragment set:html={TECH_ICONS['Jupyter'] ?? ''}/>Jupyter</span><span><Fragment set:html={TECH_ICONS['Conda'] ?? ''}/>Conda</span>
								</div>
							</div>
							<div class="skills-group">
								<p class="skill-label">Tools</p>
								<div class="skill-tags">
									<span><Fragment set:html={TECH_ICONS['Git'] ?? ''}/>Git</span><span><Fragment set:html={TECH_ICONS['GitHub Actions'] ?? ''}/>GitHub Actions</span><span><Fragment set:html={TECH_ICONS['Linux'] ?? ''}/>Linux</span><span><Fragment set:html={TECH_ICONS['Sentry'] ?? ''}/>Sentry</span><span><Fragment set:html={TECH_ICONS['Clerk'] ?? ''}/>Clerk</span>
								</div>
							</div>
							<div class="skills-group">
								<p class="skill-label">Frontend</p>
								<div class="skill-tags">
									<span><Fragment set:html={TECH_ICONS['React'] ?? ''}/>React</span><span><Fragment set:html={TECH_ICONS['Astro'] ?? ''}/>Astro</span><span><Fragment set:html={TECH_ICONS['Vanilla JS'] ?? ''}/>Vanilla JS</span><span><Fragment set:html={TECH_ICONS['Jinja2'] ?? ''}/>Jinja2</span>
								</div>
							</div>
						</div>
					</aside>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-main { padding-top: 100px; position: relative; z-index: 10; }
	.page-header { padding: 40px 0 48px; }
	.eyebrow { font-size: 11px; letter-spacing: 2.5px; text-transform: uppercase; color: var(--text-muted); margin-bottom: 12px; }
	h1 { font-size: clamp(2rem, 5vw, 3.5rem); margin-bottom: 12px; }
	.page-sub { color: var(--text-secondary); font-size: 1rem; margin: 0; }
	.section-divider { margin-bottom: 48px; }

	.resume-grid {
		display: grid;
		grid-template-columns: 1fr 280px;
		gap: 48px;
		align-items: start;
		padding-bottom: 80px;
	}
	.resume-section { margin-bottom: 48px; }
	.section-title {
		font-size: 10px;
		letter-spacing: 2.5px;
		text-transform: uppercase;
		color: var(--text-muted);
		font-weight: 400;
		margin-bottom: 20px;
		padding-bottom: 12px;
		border-bottom: 1px solid var(--border);
	}
	.resume-items { display: flex; flex-direction: column; gap: 32px; }
	.resume-item {}
	.item-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 16px;
		margin-bottom: 10px;
	}
	.item-role { font-size: 1.05rem; font-weight: 600; letter-spacing: -0.2px; margin-bottom: 3px; }
	.item-org { font-size: 13px; color: var(--text-secondary); margin: 0; }
	.item-date { font-size: 11px; letter-spacing: 0.5px; color: var(--text-muted); white-space: nowrap; padding-top: 3px; }
	.item-bullets { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 5px; }
	.item-bullets li {
		font-size: 14px;
		color: var(--text-secondary);
		line-height: 1.65;
		padding-left: 16px;
		position: relative;
	}
	.item-bullets li::before {
		content: '—';
		position: absolute;
		left: 0;
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 12px;
	}

	/* Sidebar */
	.sidebar-card {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 14px;
		padding: 20px;
		position: sticky;
		top: 80px;
	}
	.card-title {
		font-size: 10px;
		letter-spacing: 2px;
		text-transform: uppercase;
		color: var(--text-muted);
		font-weight: 400;
		margin-bottom: 20px;
	}
	.skills-group { margin-bottom: 18px; }
	.skills-group:last-child { margin-bottom: 0; }
	.skill-label { font-family: var(--font-mono); font-size: 10px; letter-spacing: 1px; color: var(--text-muted); text-transform: uppercase; margin-bottom: 8px; }
	.skill-tags { display: flex; flex-wrap: wrap; gap: 6px; }
	.skill-tags span {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		font-family: var(--font-mono);
		font-size: 11px;
		padding: 3px 10px;
		border: 1px solid var(--border);
		border-radius: 4px;
		color: var(--text-muted);
	}
	.skill-tags span svg { width: 14px; height: 14px; flex-shrink: 0; display: block; }

	@media (max-width: 768px) {
		.resume-grid { grid-template-columns: 1fr; }
		.sidebar-card { position: static; }
	}
	@media (max-width: 580px) { .page-main { padding-top: 80px; } }
</style>
